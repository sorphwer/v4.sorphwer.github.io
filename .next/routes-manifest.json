{
  "version": 4,
  "pages404": true,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "  default-src 'self';  script-src 'self' 'unsafe-eval' 'unsafe-inline' giscus.app https://*.googletagmanager.com https://ai.riino.site;  style-src 'self' 'unsafe-inline';  img-src * blob: data:;  media-src 'none';  connect-src *;  font-src 'self';  frame-src giscus.app https://jupyter.riino.site https://ai.riino.site;"
        },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "dynamicRoutes": [
    {
      "page": "/api/auth/[...auth0]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": { "auth0": "auth0" },
      "namedRegex": "^/api/auth/(?<auth0>.+?)(?:/)?$"
    },
    {
      "page": "/blog/page/[page]",
      "regex": "^/blog/page/([^/]+?)(?:/)?$",
      "routeKeys": { "page": "page" },
      "namedRegex": "^/blog/page/(?<page>[^/]+?)(?:/)?$"
    },
    {
      "page": "/blog/[...slug]",
      "regex": "^/blog/(.+?)(?:/)?$",
      "routeKeys": { "slug": "slug" },
      "namedRegex": "^/blog/(?<slug>.+?)(?:/)?$"
    },
    {
      "page": "/tags/[tag]",
      "regex": "^/tags/([^/]+?)(?:/)?$",
      "routeKeys": { "tag": "tag" },
      "namedRegex": "^/tags/(?<tag>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    { "page": "/", "regex": "^/(?:/)?$", "routeKeys": {}, "namedRegex": "^/(?:/)?$" },
    { "page": "/404", "regex": "^/404(?:/)?$", "routeKeys": {}, "namedRegex": "^/404(?:/)?$" },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    { "page": "/blog", "regex": "^/blog(?:/)?$", "routeKeys": {}, "namedRegex": "^/blog(?:/)?$" },
    {
      "page": "/profile",
      "regex": "^/profile(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/profile(?:/)?$"
    },
    {
      "page": "/projects",
      "regex": "^/projects(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/projects(?:/)?$"
    },
    { "page": "/tags", "regex": "^/tags(?:/)?$", "routeKeys": {}, "namedRegex": "^/tags(?:/)?$" }
  ],
  "dataRoutes": [
    { "page": "/", "dataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/index.json$" },
    { "page": "/about", "dataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/about.json$" },
    { "page": "/blog", "dataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/blog.json$" },
    {
      "page": "/blog/page/[page]",
      "routeKeys": { "page": "page" },
      "dataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/blog/page/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/blog/page/(?<page>[^/]+?)\\.json$"
    },
    {
      "page": "/blog/[...slug]",
      "routeKeys": { "slug": "slug" },
      "dataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/blog/(.+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/blog/(?<slug>.+?)\\.json$"
    },
    { "page": "/profile", "dataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/profile.json$" },
    { "page": "/tags", "dataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/tags.json$" },
    {
      "page": "/tags/[tag]",
      "routeKeys": { "tag": "tag" },
      "dataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/tags/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/0RqhHLUQSTw5UXtm7iVOv/tags/(?<tag>[^/]+?)\\.json$"
    }
  ],
  "rewrites": []
}
