          "value": {
            "id": "d4e635be-007e-4fcc-a9bd-72d58082e1d8",
            "version": 108,
            "type": "text",
            "properties": {
              "title": [
                ["In "],
                ["2017", [["b"]]],
                [",the website was merged into GithubPage, which is the "],
                ["riinosite hux", [["h", "blue"]]],
                [". Since then, GithubPage is the first option to deploy riinosite."]
              ]
            },
            "created_time": 1684647708103,
            "last_edited_time": 1684648392151,
            "parent_id": "d6221d12-7cda-44aa-8b4d-1422eca4979c",
