            "version": 4,
            "type": "text",
            "properties": {
              "title": [
                ["In "],
                ["2019", [["b"]]],
                [
                  ", we redesigned entire website from scratch using jekyll, and we dropped the origin jekyll template hux."
                ]
              ]
            },
            "created_time": 1684647708103,
            "last_edited_time": 1684647722877,
            "parent_id": "d6221d12-7cda-44aa-8b4d-1422eca4979c",
