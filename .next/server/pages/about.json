            "version": 88,
            "type": "text",
            "properties": {
              "title": [
                ["In "],
                ["2020,", [["b"]]],
                [
                  " we merged riinosite with website of low illuminance (li.riino.site), and isolated style template, named it as ‘"
                ],
                ["jekyll-theme-panda", [["h", "blue"]]],
                ["’."]
              ]
            },
            "created_time": 1684647708103,
            "last_edited_time": 1684648389980,
            "parent_id": "d6221d12-7cda-44aa-8b4d-1422eca4979c",
