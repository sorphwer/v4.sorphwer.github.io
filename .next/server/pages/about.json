            "version": 969,
            "type": "text",
            "properties": {
              "title": [
                ["In "],
                ["2023", [["b"]]],
                [", "],
                ["RiinoSite v4", [["h", "blue"]]],
                [
                  " Project is launched, where not only the entire blog website is re-developed using "
                ],
                ["next.js", [["c"]]],
                [", but also include the power of "],
                ["full stack framework", [["c"]]],
                [" , "],
                ["Notion", [["c"]]],
                [" and "],
                ["LLM", [["c"]]],
                [". It will support authentication via "],
                ["Auth0", [["c"]]],
                [" and has modern features like HSTS preload."]
              ]
            },
